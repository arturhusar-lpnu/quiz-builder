enum QuestionType {
  boolean
  input
  checkbox
}

model Question {
  id        Int          @id @default(autoincrement())
  quizId    Int
  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  title     String
  type      QuestionType
  createdAt DateTime     @default(now())

  booleanQuestion  BooleanQuestion?
  inputQuestion    InputQuestion?
  checkboxQuestion CheckboxQuestion?

  @@map("questions")
}

model BooleanQuestion {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     Boolean

  @@map("boolean_questions")
}

model InputQuestion {
  id         Int      @id @default(autoincrement())
  questionId Int      @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String

  @@map("input_questions")
}

model CheckboxQuestion {
  id         Int              @id @default(autoincrement())
  questionId Int              @unique
  question   Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  options    CheckboxOption[]

  @@map("checkbox_questions")
}

model CheckboxOption {
  id                 Int              @id @default(autoincrement())
  option             String
  order              Int
  isCorrect          Boolean          @default(false)
  checkboxQuestionId Int
  checkboxQuestion   CheckboxQuestion @relation(fields: [checkboxQuestionId], references: [id], onDelete: Cascade)

  @@map("checkbox_options")
}